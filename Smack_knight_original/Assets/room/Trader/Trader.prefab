--- !u!114 &8654985416806013124
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5203807858112179691}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0b93429c6df20f643a53c35d2e11db53, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueTutorial:
    name: Trader
    sentences:
    - Welcome lost soul!
    - I'm delighted to meet you!
    - From me you can buy upgrades!
    - It's easy, just step on them and they'll instantli activate.
    - 'PS: You''ll need a lot of souls.'
  dialogueTutorial3:
    name: Trader
    sentences:
    - Pst!
    - Had you noticed entity?
    - Do you like him?
    - Hm, Hm ...
  dialogueTutorial7:
    name: Trader
    sentences:
    - Had you found Cubert?
    - You should find him.
    - He's a good guy.
  dialogueTutorial13:
    name: Trader
    sentences:
    - 13 is a unlucky number, don't underestimate it!
  dialogueTutorial17:
    name: Trader
    sentences:
    - Had you ever wondered who created this world?
    - Hey!
    - How are you doing?
    - You made it so far!
    - I admire you.
  dialogue:
    name: Trader
    sentences:
